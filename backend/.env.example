# Social Media Integration Environment Variables
# Copy this file to .env and fill in your actual API credentials

# Social Media Integration Toggle
# Set to "true" to enable real social media integrations, "false" to use mock data only
SOCIAL_INTEGRATION_ENABLED=false

# ============================================================================
# TWITTER/X API CONFIGURATION
# ============================================================================
# Get these from: https://developer.twitter.com/en/portal/dashboard
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here

# ============================================================================
# LINKEDIN API CONFIGURATION  
# ============================================================================
# Get these from: https://www.linkedin.com/developers/apps/new
LINKEDIN_APP_ID=your_linkedin_app_id_here
LINKEDIN_APP_SECRET=your_linkedin_app_secret_here
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here

# ============================================================================
# FACEBOOK/META API CONFIGURATION
# ============================================================================
# Get these from: https://developers.facebook.com/apps
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token_here

# ============================================================================
# INSTAGRAM API CONFIGURATION
# ============================================================================
# Instagram uses Facebook's Graph API, so you need Facebook credentials above
# Additional Instagram-specific configurations:
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here

# ============================================================================
# WEBHOOK CONFIGURATION (Optional)
# ============================================================================
# For real-time updates from social platforms
TWITTER_WEBHOOK_SECRET=your_twitter_webhook_secret_here
LINKEDIN_WEBHOOK_SECRET=your_linkedin_webhook_secret_here
FACEBOOK_WEBHOOK_SECRET=your_facebook_webhook_secret_here

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================
# DEV_MODE=true - Uses mock data for testing (default)
# DEV_MODE=false - Uses MongoDB database
DEV_MODE=true

# Database Configuration (when DEV_MODE=false)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=social_connect

# ============================================================================
# QUICK START GUIDE
# ============================================================================
# 
# 1. TWITTER SETUP (Easiest to start with):
#    - Go to https://developer.twitter.com/en/portal/dashboard
#    - Create a new app and get API Key, API Secret
#    - Generate Access Token and Access Token Secret
#    - Set SOCIAL_INTEGRATION_ENABLED=true
#    - Fill in the TWITTER_* variables above
#
# 2. LINKEDIN SETUP:
#    - Go to https://www.linkedin.com/developers/apps/new  
#    - Create app and get Client ID (App ID) and Client Secret
#    - Set up OAuth 2.0 to get access tokens
#    - Fill in the LINKEDIN_* variables above
#
# 3. FACEBOOK SETUP:
#    - Go to https://developers.facebook.com/apps
#    - Create app and get App ID and App Secret
#    - Set up Webhooks and get Access Token
#    - Fill in the FACEBOOK_* variables above
#
# 4. SWITCHING BETWEEN REAL AND MOCK DATA:
#    - Set SOCIAL_INTEGRATION_ENABLED=true AND fill API credentials → Real data
#    - Set SOCIAL_INTEGRATION_ENABLED=false → Mock data only
#    - System automatically falls back to mock data if APIs fail
#
# ============================================================================
