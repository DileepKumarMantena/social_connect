# ============================================================================
# BREVO EMAIL CONFIGURATION - Add this to your .env file
# ============================================================================

# Get your Brevo API Key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here

# Configure sender email (must be verified in Brevo)
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Social Connect

# ============================================================================
# INSTRUCTIONS:
# 1. Replace 'your_brevo_api_key_here' with your actual Brevo API key
# 2. Replace 'noreply@yourdomain.com' with your verified sender email
# 3. Copy these lines to your .env file (remove the old ones)
# 4. Restart the backend server
# ============================================================================
